const fs=require('fs');
const files=[64,65,66,67,68,69,70,71].map(n=>`/Users/jairofortunato/mp/pdf_template/amunesc/_lotes/joinville__${n}.json`);
function dateKey(s){const m=s.match(/(\d{2})\/(\d{2})\/(\d{4})/); return m?`${m[3]}-${m[2]}-${m[1]}`:'';}
const all=[];
for(const f of files){ const data=JSON.parse(fs.readFileSync(f,'utf8')); data.casos.forEach((c,idx)=>all.push({file:f,idx,c})); }
const refs={};
for(const x of all){ if(!refs[x.c.ref]) refs[x.c.ref]=[]; refs[x.c.ref].push(x); }
for(const xs of Object.values(refs)) xs.sort((a,b)=>dateKey(a.c.data).localeCompare(dateKey(b.c.data)));
const municipalityOther=/\b(Mafra|Gaspar|Jaguaruna|Jaguar|Otacílio Costa|Otacilio Costa|Navegantes|Palhoça|São José|Sao Jose|Jaguar|Timbó|Lebon Régis|Lages|Lauro Müller|Morro Grande|Modelo|Rio Fortuna|Penha|Major Vieira|São João Batista|Rio das Antas|Mondaí|São Francisco do Sul|Schroeder|Timbé do Sul|Taió|Mafra|Orleans|Nova Trento|Lindóia do Sul|Lindóia|Lindóia do Sul)\b/i;
function substantive(dec){
  return /(denegar|deneg[ae]|irregular|ac[uú]mulo ilegal|reenquadramento irregular|aus[eê]ncia de comprova[cç][aã]o|multa|cautelar|sustar|procedente|improcedente|prescri[cç][aã]o|d[áa]no ao er[aá]rio|fraude|nepotismo|improbidade|arquivamento|não conhecer|nao conhecer|seletividade|intempestividade|monitoramento|auditoria|representa[cç][aã]o|den[uú]ncia|relat[oó]rio de inspe[cç][aã]o|relat[oó]rio de auditoria|recurso|plano de a[cç][aã]o|cautelar|sustação|sustacao|julgado irregular|julgado regular|parecer pela aprova[cç][aã]o|parecer pela rejei[cç][aã]o)/i.test(dec);
}
function routine(c){
  const s=(c.header+' '+(c.texto||'')+' '+(c.decisao||'')).toLowerCase();
  return /(aposentadoria\/pensão|ato de aposentadoria|ato de pensão|registro do ato de pensão|registro do ato de aposentadoria|registro de ato de aposentadoria|registro de ato de pensão|retificação de ato aposentatório|registro do ato de pensão e auxílio especial|registro do ato de pensão automatizado|registro do ato de aposentadoria automatizado)/i.test(c.header+' '+c.texto+' '+c.decisao) && !/(denegar|deneg|irregular|acúmulo ilegal|reenquadramento irregular|ausência de comprovação|multa|cautelar|sustar|procedente|improcedente|prescrição|dano ao erário|fraude|nepotismo|improbidade|arquivamento|não conhecer|seletividade|intempestividade)/i.test(c.decisao||'');
}
function shouldFalse(c){
  const ref=c.ref||'';
  const dec=c.decisao||'';
  const header=c.header||'';
  const text=c.texto||'';
  if(/^CON /.test(ref) || /consulta/i.test(header)) return true;
  if(routine(c)) return true;
  if(municipalityOther.test(dec) && !/Joinville/i.test(dec)) return true;
  return false;
}
for(const f of files){
  const data=JSON.parse(fs.readFileSync(f,'utf8'));
  const cand=[];
  for(const c of data.casos){
    if(!shouldFalse(c)) cand.push(`${c.i} ${c.ref} | ${c.header} | ${((c.decisao||'').slice(0,160)).replace(/\n/g,' ')}`);
  }
  console.log('\nFILE',f.split('/').pop(),'KEEP',cand.length);
  console.log(cand.join('\n'));
}
