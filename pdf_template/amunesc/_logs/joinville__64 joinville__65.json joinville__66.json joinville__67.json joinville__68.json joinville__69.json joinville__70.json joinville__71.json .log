const fs=require('fs');
const files=[64,65,66,67,68,69,70,71].map(n=>`/Users/jairofortunato/mp/pdf_template/amunesc/_lotes/joinville__${n}.json`);
for(const f of files){
  const data=JSON.parse(fs.readFileSync(f,'utf8'));
  const cand=[];
  for(const c of data.casos){
    const ref=c.ref||'';
    const header=c.header||'';
    const dec=(c.decisao||'').toLowerCase();
    const texto=(c.texto||'').toLowerCase();
    const tipo=c.tipo||'';
    const isConsulta=/^CON /.test(ref) || /consulta/.test(header.toLowerCase());
    const routinePension=/(registro do ato de pens[aã]o|registro de ato de aposentadoria|ato de aposentadoria|ato de pens[aã]o|registro do ato de pens[aã]o)/i.test(header+' '+texto+' '+dec) && /(ordenar o registro|considerado legal|considerad[oa] legal|considerar legal|considerar regulares?|julgado regular|parecer pela aprova[cç][aã]o)/i.test(dec) && !/(denegar|irregular|ac[uú]mulo ilegal|reenquadramento irregular|aus[eê]ncia de comprova[cç][aã]o|rejei[cç][aã]o|multa|d[áa]no ao er[aá]rio|fraude|nepotismo|improbidade|cautelar|susta[cç][aã]o)/i.test(dec);
    const substantive=/(irregular|cautelar|procedente|improcedente|multa|denegar|deneg|rejei[cç][aã]o|aprova[cç][aã]o|regulares?|prescri[cç][aã]o|monitoramento|auditoria|representa[cç][aã]o|den[uú]ncia|relat[oó]rio de inspe[cç][aã]o|relat[oó]rio de auditoria|recurso|plano de a[cç][aã]o|seletividade|intempestividade|arquivamento|sustar|sustação|susta[cç][aã]o)/i.test(dec+' '+header+' '+texto);
    let keep=true;
    if(isConsulta) keep=false;
    else if(routinePension && !/(denegar|irregular|ac[uú]mulo ilegal|reenquadramento irregular|aus[eê]ncia de comprova[cç][aã]o|rejei[cç][aã]o|multa|d[áa]no ao er[aá]rio|fraude|nepotismo|improbidade|cautelar|susta[cç][aã]o)/i.test(dec)) keep=false;
    else if(!substantive && /(dar ci[eê]ncia|ordenar o registro|considerado legal|considerar regular|julgado regular|arquivamento)/i.test(dec) && !/(irregular|multa|denegar|procedente|cautelar|sustar|prescri[cç][aã]o|rejei[cç][aã]o|improcedente)/i.test(dec)) keep=false;
    if(keep) cand.push(`${c.i} ${c.ref} | ${header} | ${dec.slice(0,140)}`);
  }
  console.log('\nFILE',f.split('/').pop(), 'KEEP', cand.length);
  console.log(cand.join('\n'));
}
