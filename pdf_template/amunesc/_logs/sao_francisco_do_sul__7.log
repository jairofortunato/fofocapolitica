for lot, src in inputs.items():
    with src.open('r', encoding='utf-8') as f:
        data = json.load(f)
    out = []
    for case in data['casos']:
        entry = curated.get(lot, {}).get(case['i'])
        if entry:
            out.append({
                'i': case['i'],
                'tipo': case['tipo'],
                'keep': True,
                'title': entry['title'],
                'description': entry['description'],
                'status': entry['status'],
                'severity': entry['severity'],
            })
        else:
            out.append({
                'i': case['i'],
                'tipo': case['tipo'],
                'keep': False,
                'title': '',
                'description': '',
                'status': '',
                'severity': '',
            })
    out_path = outputs[lot]
    out_path.parent.mkdir(parents=True, exist_ok=True)
    with out_path.open('w', encoding='utf-8') as f:
        json.dump(out, f, ensure_ascii=False, indent=1)
        f.write('\n')
    print(lot, len(out), sum(1 for x in out if x['keep']), sum(1 for x in out if x['severity'] == 'alta'))
