for name, src in inputs.items():
    data = json.loads(src.read_text())
    out = []
    keep_count = 0
    alta_count = 0
    for case in data['casos']:
        cur = curated.get(name, {}).get(case['i'])
        if cur is None:
            item = {'i': case['i'], 'tipo': case['tipo'], 'keep': False, 'title': '', 'description': '', 'status': '', 'severity': 'media'}
        else:
            item = {'i': case['i'], 'tipo': case['tipo'], **cur}
            keep_count += 1
            if cur['severity'] == 'alta':
                alta_count += 1
        out.append(item)
    (outputs / name).write_text(json.dumps(out, ensure_ascii=False, indent=2) + '\n')
    print(name, 'cases=', len(out), 'keep_true=', keep_count, 'alta=', alta_count)
