for name in ['joinville__52.json', 'joinville__53.json', 'joinville__54.json']:
    data = json.loads((base / name).read_text(encoding='utf-8'))
    out_cases = []
    spec = maps[name]
    for case in data['casos']:
        entry = {'i': case['i'], 'tipo': case['tipo']}
        if case['i'] in spec:
            _, title, desc, status, severity = spec[case['i']]
            entry.update({'keep': True, 'title': title, 'description': desc, 'status': status, 'severity': severity})
        else:
            entry.update({'keep': False, 'title': '', 'description': '', 'status': '', 'severity': ''})
        out_cases.append(entry)
    out_data = out_cases
    (out / name).write_text(json.dumps(out_data, ensure_ascii=False, indent=2), encoding='utf-8')
