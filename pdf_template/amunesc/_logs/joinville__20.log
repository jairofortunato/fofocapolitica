summary = []
for name, mp in maps.items():
    data = json.loads((base / name).read_text())
    out = []
    keep_true = 0
    high = 0
    for case in data['casos']:
        cur = {'i': case['i'], 'tipo': case['tipo']}
        extra = mp.get(case['i'])
        if extra:
            cur.update(extra)
            keep_true += 1
            if extra['severity'] == 'alta':
                high += 1
        else:
            cur.update({'keep': False, 'title': '', 'description': '', 'status': '', 'severity': ''})
        out.append(cur)
    (outdir / name).write_text(json.dumps(out, ensure_ascii=False, indent=2) + '\n')
    summary.append((name, len(out), keep_true, high))

for row in summary:
    print(row[0], row[1], row[2], row[3])
