for name in inputs:
    path=os.path.join(base,'_lotes',name)
    with open(path,'r',encoding='utf-8') as f:
        data=json.load(f)
    out=[]
    keep_true=0
    high=0
    for case in data['casos']:
        idx=case['i']
        item={'i':idx,'tipo':case['tipo']}
        if idx in true_map:
            item.update(true_map[idx])
            keep_true += 1
            if item['severity']=='alta':
                high += 1
        else:
            item.update(false_default)
        out.append(item)
    outpath=os.path.join(outdir,name)
    with open(outpath,'w',encoding='utf-8') as f:
        json.dump(out,f,ensure_ascii=False,indent=2)
    print(f'{name} {len(data["casos"])} {keep_true} {high}')
