for inp, out in inputs:
    data = json.loads((base / inp).read_text())
    out_cases = []
    true_set = true_sets[Path(inp).name]
    for case in data['casos']:
        keep = case['i'] in true_set
        item = {'i': case['i'], 'tipo': case['tipo'], 'keep': keep}
        if keep:
            title, description = summarize(case)
            item.update({
                'title': title,
                'description': description,
                'status': case['status'],
                'severity': 'media',
            })
        else:
            item.update({'title': '', 'description': '', 'status': '', 'severity': ''})
        out_cases.append(item)
    out_path = base / out
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(json.dumps(out_cases, ensure_ascii=False, indent=2) + '\n')
