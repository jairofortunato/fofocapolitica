for name, path in inputs.items():
    data = json.loads(path.read_text())
    cases = data['casos']
    c = curations[name]
    out = []
    for case in cases:
        cur = c.get(case['i'], {"keep": False})
        item = {
            'i': case['i'],
            'tipo': case['tipo'],
            'keep': bool(cur.get('keep', False)),
            'title': cur.get('title', ''),
            'description': cur.get('description', ''),
            'status': cur.get('status', ''),
            'severity': cur.get('severity', 'media'),
        }
        out.append(item)
    (outdir / name).write_text(json.dumps(out, ensure_ascii=False, indent=2) + '\n')
