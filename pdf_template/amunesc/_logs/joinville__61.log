    return { i: c.i, tipo: c.tipo, keep: v.keep, title: v.title, description: v.description, status: v.status, severity: v.severity };
  });
  grand.cases += output.length;
  fs.writeFileSync(path.join(outdir, fname), JSON.stringify(output, null, 2));
  const keepCount = output.filter(x => x.keep).length;
  const altaCount = output.filter(x => x.severity === 'alta').length;
  console.log(fname + ': cases=' + output.length + ' keep=' + keepCount + ' alta=' + altaCount);
}
