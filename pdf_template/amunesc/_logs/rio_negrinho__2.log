    if 'termo de ajustamento de conduta' in txt or 'tac' in txt: return '🟠 TAC firmado'
    if 'prescricao' in txt: return '⚫ prescrito'
    if 'violacao' in txt: return '🔴 apontou irregularidade'
    if 'nao foram constatadas irregularidades' in txt or 'ausencia de irregularidades' in txt: return '🟢 arquivado'
    if 'promocao de arquivamento' in txt or 'arquivamento' in txt: return '🟢 arquivado'
    return '❔ status indef.'

def mp_severity(case):
    txt = deacc(low(case.get('texto','')))
    if any(k in txt for k in HIGH_MP_KWS): return 'alta'
    if any(k in txt for k in ['transporte escolar','saude','hospital','escola','educacao']) and any(k in txt for k in ['dano','falha','irregular','preju']):
        return 'alta'
    return 'media'

def mp_title(case, status):
    subj = extract_subject_mp(case.get('texto','')) or 'apuração em São Bento do Sul'
    subj = subj[0].lower() + subj[1:] if subj else subj
    prefix = {'🟠 TAC firmado':'MP firma TAC sobre ','🟠 ACNP firmado':'MP firma acordo sobre ','🔴 ACP ajuizada':'MP leva à Justiça apuração sobre ','⚫ prescrito':'MP encerra caso prescrito sobre ','🔴 apontou irregularidade':'MP aponta irregularidade em ','❔ status indef.':'MP registra apuração sobre ','🟢 arquivado':'MP arquiva apuração sobre '}.get(status,'MP arquiva apuração sobre ')
    title = prefix + subj
    return title[:87].rstrip() + '...' if len(title) > 90 else title

def mp_desc(case, status):
    txt = deacc(low(case.get('texto','')))
    subj = extract_subject_mp(case.get('texto','')) or 'o caso'
    subj = subj[0].lower() + subj[1:] if subj else subj
    if 'desvio de funcao configurado' in txt: result = 'O desvio de função foi reconhecido, mas sem dano ao erário ou improbidade.'
    elif 'ato de improbidade administrativa nao configurado' in txt or 'inexistencia de ato de improbidade administrativa' in txt: result = 'O MP concluiu que não houve ato de improbidade.'
    elif 'ausencia de irregularidades' in txt or 'nao ha noticias de irregularidade' in txt: result = 'Não foram constatadas irregularidades.'
    elif 'irregularidade sanada' in txt or 'regularizado' in txt or 'correcao' in txt: result = 'A irregularidade foi sanada durante a apuração.'
    elif 'dano ao erario' in txt: result = 'O caso tratava de possível dano ao erário.'
    elif 'ajuizamento de acao civil publica' in txt: result = 'O procedimento terminou com ajuizamento de ação civil pública.'
    elif 'termo de ajustamento de conduta' in txt or 'tac' in txt: result = 'Foi firmado TAC para ajustar a conduta apurada.'
    elif 'acordo de nao perseguicao civel' in txt or 'acnp' in txt: result = 'Foi firmado acordo para encerrar a apuração.'
    elif 'prescricao' in txt: result = 'O possível ilícito foi alcançado pela prescrição.'
    elif 'violacao' in txt: result = 'O órgão apontou violação e adotou a providência indicada no texto.'
    else: result = 'O caso foi encerrado conforme o texto de origem.'
    closure = {'🟠 TAC firmado':'encerrado com TAC','🟠 ACNP firmado':'encerrado com acordo','🔴 ACP ajuizada':'encerrado com ação judicial','⚫ prescrito':'encerrado por prescrição','🔴 apontou irregularidade':'encerrado com apontamento de irregularidade','❔ status indef.':'sem desfecho claro no texto','🟢 arquivado':'arquivado'}.get(status,'arquivado')
    return norm(f'O MP apurou {subj}. {result} O caso ficou {closure}.')

def tce_selected_keep(case):
    header = deacc(low(case.get('header','')))
    ref = case.get('ref','')
    dec = deacc(low(case.get('decisao','')))
    if 'consulta' in header or ref.startswith('CON '): return False
    if re.search(r'ordenar o registro', dec) and ('considerado legal' in dec or 'considerando-os legais' in dec or 'considerado legal conforme analise realizada' in dec) and ('aposent' in header or 'aposent' in dec or 'pensao' in header or 'pensao' in dec):
        return False
    substantive = any(k in dec for k in ['denegar o registro','considerado ilegal','julgado irregular','apontou irregularidade','rejeicao','ausencia de certidao']) or actual_multa(dec) or 'fixar o prazo' in dec or 'sanar a restricao' in dec
    if substantive:
        return True
    if any(k in dec for k in ['suspendendo-se','devolucao dos autos','retorno dos autos','conhecer do recurso','nao conhecer']) and not substantive:
        return False
    if len(dec) < 100 and not substantive:
        return False
    return False

def tce_status(case):
    dec = deacc(low(case.get('decisao','')))
    if actual_multa(dec): return '🔴 multa aplicada'
    if 'denegar o registro' in dec or 'considerado ilegal' in dec or 'julgado irregular' in dec: return '⬛ julgado irregular'
    if 'apontou irregularidade' in dec: return '🔴 apontou irregularidade'
    if 'rejeicao' in dec: return '🔴 parecer pela rejeição'
    if 'cautelar' in dec or 'sustacao' in dec: return '🟠 cautelar / sustação'
    if 'fixar o prazo' in dec or 'sanar a restricao' in dec or 'ausencia de certidao' in dec: return '🟡 em instrução (citação/audiência)'
    if 'nao conhecer' in dec: return '❔ não conhecido (sem análise)'
    return '❔ em tramitação'

def tce_severity(case, keep):
    if not keep: return 'media'
    dec = deacc(low(case.get('decisao','')))
    return 'alta' if actual_multa(dec) or 'dano ao erario' in dec else 'media'

def tce_title(case, status):
    subj = extract_subject_tce(case)
    dec = deacc(low(case.get('decisao','')))
    if status == '⬛ julgado irregular':
        if 'ausencia de certidao' in dec or 'sanar a restricao' in dec:
            return f'TCE cobra certidão em aposentadoria de {subj}' if subj else 'TCE cobra certidão em aposentadoria'
        return f'TCE barra aposentadoria de {subj}' if subj else 'TCE barra ato de aposentadoria'
    if status == '🟡 em instrução (citação/audiência)':
        return f'TCE cobra certidão ausente em aposentadoria de {subj}' if subj else 'TCE cobra certidão ausente em aposentadoria'
    if status == '🔴 apontou irregularidade':
        return f'TCE aponta irregularidade em {subj}' if subj else 'TCE aponta irregularidade'
    if status == '🟠 cautelar / sustação':
        return f'TCE suspende caso de {subj}' if subj else 'TCE suspende caso'
    if status == '❔ não conhecido (sem análise)':
        return f'TCE não conhece recurso sobre {subj}' if subj else 'TCE não conhece o caso'
    return f'TCE analisa {subj}' if subj else 'TCE analisa caso'

def tce_desc(case, status):
    dec = deacc(low(case.get('decisao','')))
    subj = extract_subject_tce(case) or 'o ato'
    if status == '⬛ julgado irregular':
        if 'ausencia de certidao' in dec or 'sanar a restricao' in dec:
            return f'O Tribunal apontou falta de certidão de tempo de contribuição no ato de {subj}. O instituto recebeu prazo para regularizar a situação. O caso segue com irregularidade formal.'
        return f'O Tribunal negou o registro do ato de {subj} por irregularidade no benefício. A unidade gestora foi chamada a corrigir a falha. O caso ficou marcado como irregular.'
    if status == '🟡 em instrução (citação/audiência)':
        return f'O Tribunal deu prazo para sanar a pendência no ato de {subj}. Ainda não houve desfecho final de mérito. O caso segue em instrução.'
    if status == '🔴 apontou irregularidade':
        return f'O Tribunal identificou irregularidade no ato de {subj}. A decisão registrou a falha e determinou as providências cabíveis. O caso segue com apontamento formal.'
    if status == '🟠 cautelar / sustação':
        return f'O Tribunal suspendeu os efeitos do caso de {subj}. A medida é cautelar e antecede o julgamento definitivo. O processo segue em análise.'
    if status == '❔ não conhecido (sem análise)':
        return f'O Tribunal não conheceu do recurso ligado a {subj} porque faltou requisito de admissibilidade. Não houve análise do mérito. O caso foi encerrado sem exame substantivo.'
    return f'O Tribunal analisou o caso de {subj}. O texto de origem não deixa claro um desfecho de mérito mais forte. O caso segue na categoria indicada.'

for fname in files:
    data = json.load(open(IN_DIR / fname, 'r', encoding='utf-8'))
    cases = data['casos']
    sel_mp = selected_by_ref(cases, mp_phase_score)
    sel_tce = selected_by_ref(cases, tce_phase_score)
    out = []
    for idx, case in enumerate(cases):
        ref = case.get('ref', f'__idx_{idx}')
        if case.get('tipo') == 'mp':
            keep = mp_keep(case, sel_mp.get(ref, idx) == idx)
            if keep:
                status = mp_status(case)
                severity = mp_severity(case)
                title = mp_title(case, status)
                description = mp_desc(case, status)
            else:
                status = title = description = ''
                severity = 'media'
        else:
            keep = tce_selected_keep(case) and sel_tce.get(ref, idx) == idx
            if keep:
                status = tce_status(case)
                severity = tce_severity(case, keep)
                title = tce_title(case, status)
                description = tce_desc(case, status)
            else:
                status = title = description = ''
                severity = 'media'
        out.append({'i': case['i'], 'tipo': case['tipo'], 'keep': keep, 'title': title, 'description': description, 'status': status, 'severity': severity})
    with open(OUT_DIR / fname, 'w', encoding='utf-8') as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
        f.write('\n')
print('rewritten')
