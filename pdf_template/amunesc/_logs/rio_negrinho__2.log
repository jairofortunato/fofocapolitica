import json, re, os
from pathlib import Path

ROOT = Path('/Users/jairofortunato/mp')
IN_DIR = ROOT / 'pdf_template' / 'amunesc' / '_lotes'
OUT_DIR = ROOT / 'pdf_template' / 'amunesc' / '_lotes_curados'
OUT_DIR.mkdir(exist_ok=True)

files = [
    'rio_negrinho__2.json',
    'sao_bento_do_sul__0.json',
    'sao_bento_do_sul__1.json',
]

HIGH_MP_KWS = [
    'dano ao erário', 'multa', 'fraude', 'nepot', 'improbidade ajuizada',
    'prejuízo ao erário', 'prejuizo ao erario', 'licita', 'licitação fraud',
    'licitacao fraud', 'serviço essencial', 'servico essencial', 'saúde', 'educa',
]
HIGH_TCE_KWS = ['multa', 'dano ao erário', 'dano ao erario']


def norm(s: str) -> str:
    return re.sub(r'\s+', ' ', s or '').strip()


def low(s: str) -> str:
    return norm(s).lower()


def strip_accents(s: str) -> str:
    # keep ASCII-ish output for robust matching
    import unicodedata
    return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c))


def text_len_no_spaces(s: str) -> int:
    return len(re.sub(r'\s+', '', s or ''))


def extract_subject_mp(text: str) -> str:
    t = norm(text)
    patterns = [
        r'Conclusão:\s*(?:Inquérito Civil|Procedimento Preparatório|Procedimento Preparatório instaurado|Procedimento Administrativo|Procedimento Preparatório\.)?\s*[^.]*?Apurar\s+(.*?)(?:\.|;|$)',
        r'Conclusão:\s*[^.]*?\s+Apuração\s+(.*?)(?:\.|;|$)',
        r'Conclusão:\s*(.*?)(?:Promoção de arquivamento|Submissão à homologação|Arquivamento|$)',
        r'Apurar\s+(.*?)(?:\.|;|$)',
        r'Apuração\s+(.*?)(?:\.|;|$)',
    ]
    for pat in patterns:
        m = re.search(pat, t, flags=re.I)
        if m:
            subj = norm(m.group(1))
            subj = re.sub(r'^[,\-: ]+', '', subj)
            subj = re.sub(r'\s+', ' ', subj)
            subj = subj.rstrip('…')
            # trim overly generic lead-ins
            subj = re.sub(r'^(de|da|do|das|dos)\s+', '', subj, flags=re.I)
            if len(subj) >= 8:
                return subj
    # fallback: take chunk after conclusão and before the first strong closure marker
    for marker in ['Promoção de arquivamento', 'Submissão à homologação', 'Ajuizamento de ação civil pública', 'Arquivamento', 'Termo de Ajustamento de Conduta', 'Acordo de Não Persecução Cível', 'Acordo de não persecução cível']:
        if marker.lower() in low(t):
            idx = low(t).find(marker.lower())
            prefix = t[:idx]
            # try to keep the sentence around the issue
            m2 = re.search(r'Apurar\s+(.*)$', prefix, flags=re.I)
            if m2:
                subj = norm(m2.group(1)).rstrip('.')
                if len(subj) >= 8:
                    return subj
    # last resort: first 90 chars of text after 'Conclusão:'
    if 'Conclusão:' in t:
        tail = t.split('Conclusão:', 1)[1].strip()
        tail = re.sub(r'^(Inquérito Civil|Procedimento Preparatório|Procedimento Administrativo)\.?\s*', '', tail, flags=re.I)
        tail = norm(tail)
        if len(tail) > 90:
            tail = tail[:87].rstrip() + '...'
        return tail
    return ''


def extract_subject_tce(case) -> str:
    dec = norm(case.get('decisao', ''))
    txt = norm(case.get('texto', ''))
    blob = dec + ' ' + txt
    # names from phrases like "de X" or after "benefício de"
    pats = [
        r'aposentadoria de\s+([^,\.]+)',
        r'retificação de aposentadoria de\s+([^,\.]+)',
        r'registro de ato de aposentadoria de\s+([^,\.]+)',
        r'ato de aposentadoria de\s+([^,\.]+)',
        r'benefício de\s+([^,\.]+)',
        r'em benefício de\s+([^,\.]+)',
    ]
    for pat in pats:
        m = re.search(pat, blob, flags=re.I)
        if m:
            subj = norm(m.group(1))
            subj = re.sub(r'\s+', ' ', subj)
            # trim if there are multiple names / trailing office text
            subj = subj.split('  ')[0]
            subj = subj.split('considerado')[0].strip(' ,;:-')
            if len(subj) >= 3:
                return subj
    # fallback: use municipality/process subject snippet
    if 'Rio Negrinho' in blob:
        return 'caso de Rio Negrinho'
    return ''


def mp_keep(case, selected):
    txt = norm(case.get('texto', ''))
    header = low(case.get('header', ''))
    if selected is False:
        return False
    # instantiation-only or too vague
    if 'instauração' in header or 'instauracao' in strip_accents(header):
        if not re.search(r'(?i)apurar|irregular|desvio|licit|saude|educa|alvara|horas extras|folga|dano|fraude|improb', txt):
            return False
    if len(re.sub(r'\s+', '', txt)) < 45:
        return False
    if re.fullmatch(r'[\w\s,\.\-;:/()]+', txt) and len(re.findall(r'[A-Za-zÁÉÍÓÚÂÊÔÃÕáéíóúâêôãõ]', txt)) < 8:
        return False
    # if only names / entities and no issue words, cut
    if not re.search(r'(?i)apurar|irregular|desvio|licit|saude|educa|alvara|horas extras|folga|dano|fraude|improb|omiss|polui|esgoto|transporte|consulta|contrata|pessoal|vacina|sindicat|médic|medic|servidor|obra|licen', txt):
        return False
    return True


def mp_status(case):
    txt = low(case.get('texto', ''))
    if 'ajuizamento de ação civil pública' in txt or 'ajuizamento de acao civil publica' in strip_accents(txt):
        return '🔴 ACP ajuizada'
    if 'acordo de não persecução cível' in txt or 'acordo de nao perseguicao civel' in strip_accents(txt) or 'acnp' in txt:
        return '🟠 ACNP firmado'
    if 'termo de ajustamento de conduta' in txt or 'tac' in txt:
        return '🟠 TAC firmado'
    if 'prescrição' in txt or 'prescricao' in strip_accents(txt):
        return '⚫ prescrito'
    if 'não foram constatadas irregularidades' in txt or 'nao foram constatadas irregularidades' in strip_accents(txt):
        return '🟢 arquivado'
    if 'ausência de irregularidades' in txt or 'ausencia de irregularidades' in strip_accents(txt):
        return '🟢 arquivado'
    if 'promoção de arquivamento' in txt or 'promocao de arquivamento' in strip_accents(txt) or 'arquivamento' in txt:
        return '🟢 arquivado'
    if 'violação' in txt or 'violacao' in strip_accents(txt):
        return '🔴 apontou irregularidade'
    return '❔ status indef.'


def mp_severity(case):
    txt = low(case.get('texto', ''))
    if any(k in txt for k in HIGH_MP_KWS):
        return 'alta'
    # if explicit essential service harm, treat as high
    if any(k in txt for k in ['transporte escolar', 'saúde', 'saude', 'hospital', 'escola', 'educação', 'educacao']) and any(k in txt for k in ['dano', 'falha', 'irregular', 'preju']):
        return 'alta'
    return 'media'


def mp_title(case, status):
    subj = extract_subject_mp(case.get('texto', ''))
    if not subj:
        subj = 'apuração em São Bento do Sul'
    subj = subj[0].lower() + subj[1:] if subj else subj
    subj = subj.rstrip('.;')
    if status == '🟠 TAC firmado':
        prefix = 'MP firma TAC sobre '
    elif status == '🟠 ACNP firmado':
        prefix = 'MP firma acordo sobre '
    elif status == '🔴 ACP ajuizada':
        prefix = 'MP leva à Justiça apuração sobre '
    elif status == '⚫ prescrito':
        prefix = 'MP encerra caso prescrito sobre '
    elif status == '🔴 apontou irregularidade':
        prefix = 'MP aponta irregularidade em '
    elif status == '❔ status indef.':
        prefix = 'MP registra apuração sobre '
    else:
        prefix = 'MP arquiva apuração sobre '
    title = prefix + subj
    if len(title) > 90:
        title = title[:87].rstrip() + '...'
    return title


def mp_description(case, status):
    txt = low(case.get('texto', ''))
    subj = extract_subject_mp(case.get('texto', '')) or 'o caso'
    subj = subj[0].lower() + subj[1:] if subj else subj
    result = ''
    if 'desvio de função configurado' in txt:
        result = 'O desvio de função foi reconhecido, mas sem dano ao erário ou improbidade.'
    elif 'ato de improbidade administrativa não configurado' in txt or 'inexistência de ato de improbidade administrativa' in txt:
        result = 'O MP concluiu que não houve ato de improbidade.'
    elif 'ausência de irregularidades' in txt or 'não há notícias de irregularidade' in txt or 'nao ha noticias de irregularidade' in strip_accents(txt):
        result = 'Não foram constatadas irregularidades.'
    elif 'irregularidade sanada' in txt or 'regularizado' in txt or 'correção' in txt:
        result = 'A irregularidade foi sanada durante a apuração.'
    elif 'dano ao erário' in txt or 'dano ao erario' in strip_accents(txt):
        result = 'O caso tratava de possível dano ao erário.'
    elif 'ajuizamento de ação civil pública' in txt or 'ajuizamento de acao civil publica' in strip_accents(txt):
        result = 'O procedimento terminou com ajuizamento de ação civil pública.'
    elif 'termo de ajustamento de conduta' in txt or 'tac' in txt:
        result = 'Foi firmado TAC para ajustar a conduta apurada.'
    elif 'acordo de não persecução cível' in txt or 'acordo de nao perseguicao civel' in strip_accents(txt) or 'acnp' in txt:
        result = 'Foi firmado acordo para encerrar a apuração.'
    elif 'prescrição' in txt or 'prescricao' in strip_accents(txt):
        result = 'O possível ilícito foi alcançado pela prescrição.'
    elif 'violação' in txt or 'violacao' in strip_accents(txt):
        result = 'O órgão apontou violação e adotou a providência indicada no texto.'
    else:
        result = 'O caso foi encerrado conforme o texto de origem.'
    closure = {
        '🟠 TAC firmado': 'encerrado com TAC',
        '🟠 ACNP firmado': 'encerrado com acordo',
        '🔴 ACP ajuizada': 'encerrado com ação judicial',
        '⚫ prescrito': 'encerrado por prescrição',
        '🔴 apontou irregularidade': 'encerrado com apontamento de irregularidade',
        '❔ status indef.': 'sem desfecho claro no texto',
        '🟢 arquivado': 'arquivado',
    }.get(status, 'arquivado')
    desc = f'O MP apurou {subj}. {result} O caso ficou {closure}.'
    return norm(desc)


def tce_selected_keep(case):
    header = low(case.get('header', ''))
    ref = case.get('ref', '')
    dec = low(case.get('decisao', ''))
    txt = low(case.get('texto', ''))
    # consultations never enter
    if 'consulta' in header or ref.startswith('CON '):
        return False
    # routine legal retirement registrations are out
    if re.search(r'ordenar o registro', dec) and (
        'considerado legal' in dec or 'considerando-os legais' in dec or 'considerando-os legais' in txt or 'considerado legal conforme análise realizada' in dec or 'considerado legal' in dec
    ) and ('aposent' in header or 'aposent' in dec or 'pensão' in header or 'pensao' in dec):
        return False
    # procedural appeals without factual substance are out
    if ref.startswith('REC '):
        if any(k in dec for k in ['suspendendo-se', 'devolução dos autos', 'retorno dos autos', 'conhecer do recurso']) and not any(k in dec for k in ['denegar', 'irregular', 'multa', 'cautelar', 'sustação', 'sustacao']):
            return False
        # non-knowledge due admissibility issues: no substantive card
        if 'não conhecer' in dec or 'nao conhecer' in strip_accents(dec):
            return False
        if 'provimento' in dec and not any(k in dec for k in ['ilegal', 'irregular', 'multa', 'cautelar']):
            return False
        return False
    # TCE appeal/APE cases with legal register and no irregularity are out
    if re.search(r'ordenar o registro', dec) and ('legal' in dec or 'considerado legal' in dec) and not any(k in dec for k in ['denegar', 'irregular', 'multa', 'cautelar', 'sustação', 'sustacao', 'anular', 'citação', 'citacao']):
        return False
    # pure procedures or incomplete without outcome out
    if len(dec) < 100 and not any(k in dec for k in ['denegar', 'irregular', 'multa', 'cautelar', 'não conhecer', 'nao conhecer', 'prescrito', 'rejeição', 'rejeicao']):
        return False
    # if clearly regular but with a small warning, usually still out
    if 'considerado legal' in dec and not any(k in dec for k in ['denegar', 'irregular', 'multa', 'cautelar', 'sustação', 'sustacao']):
        return False
    # otherwise keep if substantive
    if any(k in dec for k in ['denegar o registro', 'considerado ilegal', 'multa', 'cautelar', 'sustação', 'sustacao', 'julgado irregular', 'apontou irregularidade', 'rejeição', 'rejeicao', 'não conhecer do recurso', 'nao conhecer do recurso']):
        return True
    # special case: fixing deadline to sanear irregularity with explicit defect
    if any(k in dec for k in ['fixar o prazo', 'sanar a restrição', 'sanar a restricao', 'ausência de certidão', 'ausencia de certidao']):
        return True
    return False


def tce_status(case):
    dec = low(case.get('decisao', ''))
    if any(k in dec for k in ['multa aplicada', 'cominação', 'cominacao']) or ('multa' in dec and any(k in dec for k in ['julgado irregular', 'denegar'])):
        return '🔴 multa aplicada' if 'multa aplicada' in dec else '⬛ julgado irregular + multa'
    if 'denegar o registro' in dec or 'considerado ilegal' in dec or 'julgado irregular' in dec:
        return '⬛ julgado irregular'
    if 'apontou irregularidade' in dec:
        return '🔴 apontou irregularidade'
    if 'rejeição' in dec or 'rejeicao' in strip_accents(dec):
        return '🔴 parecer pela rejeição'
    if any(k in dec for k in ['cautelar', 'sustação', 'sustacao']):
        return '🟠 cautelar / sustação'
    if any(k in dec for k in ['fixar o prazo', 'sanar a restrição', 'sanar a restricao', 'ausência de certidão', 'ausencia de certidao', 'determinad']) and ('registro' not in dec or 'considerado legal' not in dec):
        return '🟡 em instrução (citação/audiência)'
    if 'não conhecer' in dec or 'nao conhecer' in strip_accents(dec):
        return '❔ não conhecido (sem análise)'
    return '❔ em tramitação'


def tce_severity(case, keep):
    if not keep:
        return 'media'
    dec = low(case.get('decisao', ''))
    if any(k in dec for k in HIGH_TCE_KWS) or 'multa aplicada' in dec:
        return 'alta'
    return 'media'


def tce_title(case, status):
    subj = extract_subject_tce(case)
    dec = low(case.get('decisao', ''))
    if status == '⬛ julgado irregular':
        if 'ausência de certidão' in dec or 'ausencia de certidao' in strip_accents(dec) or 'sanar a restrição' in dec:
            return f'TCE cobra certidão de aposentadoria de {subj}'
        return f'TCE barra ato de {subj}' if subj else 'TCE barra ato em Rio Negrinho'
    if status == '🟡 em instrução (citação/audiência)':
        if 'ausência de certidão' in dec or 'ausencia de certidao' in strip_accents(dec):
            return f'TCE cobra certidão ausente em aposentadoria de {subj}' if subj else 'TCE cobra certidão ausente em aposentadoria'
        return f'TCE abre prazo para ajustar ato de {subj}' if subj else 'TCE abre prazo para ajustar ato'
    if status == '🔴 apontou irregularidade':
        return f'TCE aponta irregularidade em {subj}' if subj else 'TCE aponta irregularidade'
    if status == '🟠 cautelar / sustação':
        return f'TCE suspende caso de {subj}' if subj else 'TCE suspende caso'
    if status == '❔ não conhecido (sem análise)':
        return f'TCE não conhece recurso sobre {subj}' if subj else 'TCE não conhece o caso'
    return f'TCE analisa {subj}' if subj else 'TCE analisa caso'


def tce_description(case, status):
    dec = low(case.get('decisao', ''))
    subj = extract_subject_tce(case) or 'o ato'
    if status == '⬛ julgado irregular':
        if 'ausência de certidão' in dec or 'ausencia de certidao' in strip_accents(dec):
            return f'O Tribunal apontou falta de certidão de tempo de contribuição no ato de {subj}. O instituto recebeu prazo para regularizar a situação. O caso segue com irregularidade formal.'
        if 'considerado ilegal' in dec:
            return f'O Tribunal negou o registro do ato de {subj} por irregularidade no benefício. A unidade gestora foi chamada a corrigir a falha. O caso ficou marcado como irregular.'
        return f'O Tribunal julgou irregular o caso de {subj}. A decisão impôs providências ao responsável. O processo ficou com desfecho desfavorável.'
    if status == '🟡 em instrução (citação/audiência)':
        return f'O Tribunal deu prazo para sanar a pendência no ato de {subj}. Ainda não houve desfecho final de mérito. O caso segue em instrução.'
    if status == '🔴 apontou irregularidade':
        return f'O Tribunal identificou irregularidade no ato de {subj}. A decisão registrou a falha e determinou as providências cabíveis. O caso segue com apontamento formal.'
    if status == '🟠 cautelar / sustação':
        return f'O Tribunal suspendeu os efeitos do caso de {subj}. A medida é cautelar e antecede o julgamento definitivo. O processo segue em análise.'
    if status == '❔ não conhecido (sem análise)':
        return f'O Tribunal não conheceu do recurso ligado a {subj} porque faltou requisito de admissibilidade. Não houve análise do mérito. O caso foi encerrado sem exame substantivo.'
    return f'O Tribunal analisou o caso de {subj}. O texto de origem não deixa claro um desfecho de mérito mais forte. O caso segue na categoria indicada.'

# collect all files first
all_data = {}
for fname in files:
    with open(IN_DIR / fname, 'r', encoding='utf-8') as f:
        all_data[fname] = json.load(f)

for fname, data in all_data.items():
    cases = data['casos']
    # phase selection per ref: prefer conclusion over instauração; otherwise later date
    groups = {}
    for idx, case in enumerate(cases):
        ref = case.get('ref', f'__idx_{idx}')
        groups.setdefault(ref, []).append((idx, case))

    selected = {}
    for ref, items in groups.items():
        def phase_score(case):
            header = low(case.get('header', ''))
            text = low(case.get('texto', ''))
            dec = low(case.get('decisao', ''))
            score = 0
            if 'conclusão' in header or 'conclusao' in strip_accents(header) or 'conclusão:' in text or 'conclusao:' in strip_accents(text):
                score = 2
            elif 'instauração' in header or 'instauracao' in strip_accents(header):
                score = 1
            elif any(k in dec for k in ['decido', 'decide', 'acórdão', 'acordao']):
                score = 2
            return score
        def date_key(case):
            d = case.get('data', '0000-00-00')
            m = re.match(r'(\d{2})/(\d{2})/(\d{4})', d)
            if m:
                return (int(m.group(3)), int(m.group(2)), int(m.group(1)))
            return (0, 0, 0)
        best_idx, best_case = max(items, key=lambda ic: (phase_score(ic[1]), date_key(ic[1]), ic[0]))
        selected[ref] = best_idx

    out = []
    for idx, case in enumerate(cases):
        ref = case.get('ref', f'__idx_{idx}')
        is_selected = selected.get(ref, idx) == idx
        if case.get('tipo') == 'mp':
            keep = mp_keep(case, is_selected)
            if keep:
                status = mp_status(case)
                severity = mp_severity(case)
                title = mp_title(case, status)
                description = mp_description(case, status)
            else:
                status = ''
                title = ''
                description = ''
                severity = 'media'
        else:
            keep = tce_selected_keep(case) and is_selected
            if keep:
                status = tce_status(case)
                severity = tce_severity(case, keep)
                title = tce_title(case, status)
                description = tce_description(case, status)
            else:
                status = ''
                title = ''
                description = ''
                severity = 'media'
        out.append({
            'i': case['i'],
            'tipo': case['tipo'],
            'keep': keep,
            'title': title,
            'description': description,
            'status': status,
            'severity': severity,
        })

    with open(OUT_DIR / fname, 'w', encoding='utf-8') as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
        f.write('\n')

print('written:', ', '.join(files))
