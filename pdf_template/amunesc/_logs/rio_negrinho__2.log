import json, re
from pathlib import Path
import unicodedata

ROOT = Path('/Users/jairofortunato/mp')
IN_DIR = ROOT / 'pdf_template' / 'amunesc' / '_lotes'
OUT_DIR = ROOT / 'pdf_template' / 'amunesc' / '_lotes_curados'
OUT_DIR.mkdir(exist_ok=True)
files = ['rio_negrinho__2.json','sao_bento_do_sul__0.json','sao_bento_do_sul__1.json']

HIGH_MP_KWS = ['dano ao erário','dano ao erario','multa','fraude','nepot','improbidade ajuizada','prejuízo ao erário','prejuizo ao erario']
HIGH_TCE_KWS = ['multa','dano ao erário','dano ao erario']


def norm(s):
    return re.sub(r'\s+', ' ', s or '').strip()

def low(s):
    return norm(s).lower()

def deacc(s):
    return ''.join(c for c in unicodedata.normalize('NFKD', s) if not unicodedata.combining(c))


def extract_subject_mp(text):
    t = norm(text)
    pats = [
        r'Apurar\s+(.*?)(?:\.|;|$)',
        r'Apuração\s+(.*?)(?:\.|;|$)',
    ]
    for pat in pats:
        m = re.search(pat, t, flags=re.I)
        if m:
            subj = norm(m.group(1)).rstrip('…')
            if len(subj) >= 8:
                return subj
    if 'Conclusão:' in t:
        tail = t.split('Conclusão:', 1)[1].strip()
        tail = re.sub(r'^(Inquérito Civil|Procedimento Preparatório|Procedimento Administrativo)\.?\s*', '', tail, flags=re.I)
        if len(tail) > 90:
            tail = tail[:87].rstrip() + '...'
        return tail
    return ''


def extract_subject_tce(case):
    blob = norm(case.get('decisao','')) + ' ' + norm(case.get('texto',''))
    pats = [
        r'retificação de aposentadoria de\s+([^,\.]+?)(?:,\s|\s+servidor|\s+servidora|\s+ocupante|\s+CPF|\s+considerado|\s+consubstanciado|$)',
        r'ato de retificação de aposentadoria de\s+([^,\.]+?)(?:,\s|\s+servidor|\s+servidora|\s+ocupante|\s+CPF|\s+considerado|\s+consubstanciado|$)',
        r'ato de aposentadoria de\s+([^,\.]+?)(?:,\s|\s+servidor|\s+servidora|\s+ocupante|\s+CPF|\s+considerado|\s+consubstanciado|$)',
        r'registro de ato de aposentadoria de\s+([^,\.]+?)(?:,\s|\s+servidor|\s+servidora|\s+ocupante|\s+CPF|\s+considerado|\s+consubstanciado|$)',
        r'aposentadoria de\s+([^,\.]+?)(?:,\s|\s+servidor|\s+servidora|\s+ocupante|\s+CPF|\s+considerado|\s+consubstanciado|$)',
        r'benefício de\s+([^,\.]+?)(?:,\s|\s+servidor|\s+servidora|\s+ocupante|\s+CPF|\s+considerado|\s+consubstanciado|$)',
        r'em benefício de\s+([^,\.]+?)(?:,\s|\s+servidor|\s+servidora|\s+ocupante|\s+CPF|\s+considerado|\s+consubstanciado|$)',
    ]
    for pat in pats:
        m = re.search(pat, blob, flags=re.I)
        if m:
            subj = norm(m.group(1))
            subj = subj.split(' e ')[0].strip(' ,;:-')
            if len(subj) >= 3:
                return subj
    if 'Rio Negrinho' in blob:
        return 'Rio Negrinho'
    return ''


def mp_phase_score(case):
    header = low(case.get('header',''))
    text = low(case.get('texto',''))
    if 'conclusão' in deacc(header) or 'conclusao' in deacc(text) or 'conclusão:' in text or 'conclusao:' in deacc(text):
        return 2
    if 'instauração' in deacc(header) or 'instauracao' in deacc(header):
        return 1
    return 1


def tce_phase_score(case):
    dec = low(case.get('decisao',''))
    if any(k in dec for k in ['denegar','multa','cautelar','sustação','sustacao','julgado irregular','apontou irregularidade','rejeição','rejeicao','ausência de certidão','ausencia de certidao']):
        return 2
    if any(k in dec for k in ['decide', 'decido', 'acórdão', 'acordao']):
        return 1
    return 0


def selected_by_ref(cases, phase_fn):
    groups = {}
    for idx, case in enumerate(cases):
        ref = case.get('ref', f'__idx_{idx}')
        groups.setdefault(ref, []).append((idx, case))
    selected = {}
    for ref, items in groups.items():
        def date_key(case):
            d = case.get('data', '0000-00-00')
            m = re.match(r'(\d{2})/(\d{2})/(\d{4})', d)
            return (int(m.group(3)), int(m.group(2)), int(m.group(1))) if m else (0,0,0)
        best_idx, _ = max(items, key=lambda ic: (phase_fn(ic[1]), date_key(ic[1]), ic[0]))
        selected[ref] = best_idx
    return selected


def mp_keep(case, selected):
    if not selected:
        return False
    txt = norm(case.get('texto',''))
    header = low(case.get('header',''))
    if 'instauração' in deacc(header) and not re.search(r'(?i)apurar|irregular|desvio|licit|saude|educa|alvara|horas extras|folga|dano|fraude|improb|omiss|polui|esgoto|transporte|consulta|contrata|pessoal|vacina|sindicat|médic|medic|servidor|obra|licen', txt):
        return False
    if len(re.sub(r'\s+', '', txt)) < 45:
        return False
    if not re.search(r'(?i)apurar|irregular|desvio|licit|saude|educa|alvara|horas extras|folga|dano|fraude|improb|omiss|polui|esgoto|transporte|consulta|contrata|pessoal|vacina|sindicat|médic|medic|servidor|obra|licen|conclusão|conclusao', txt):
        return False
    return True


def mp_status(case):
    txt = low(case.get('texto',''))
    if 'ajuizamento de ação civil pública' in txt or 'ajuizamento de acao civil publica' in deacc(txt):
        return '🔴 ACP ajuizada'
    if 'acordo de não persecução cível' in txt or 'acordo de nao perseguicao civel' in deacc(txt) or 'acnp' in txt:
        return '🟠 ACNP firmado'
    if 'termo de ajustamento de conduta' in txt or 'tac' in txt:
        return '🟠 TAC firmado'
    if 'prescrição' in txt or 'prescricao' in deacc(txt):
        return '⚫ prescrito'
    if 'violação' in txt or 'violacao' in deacc(txt):
        return '🔴 apontou irregularidade'
    if 'não foram constatadas irregularidades' in txt or 'nao foram constatadas irregularidades' in deacc(txt) or 'ausência de irregularidades' in txt or 'ausencia de irregularidades' in deacc(txt):
        return '🟢 arquivado'
    if 'promoção de arquivamento' in txt or 'promocao de arquivamento' in deacc(txt) or 'arquivamento' in txt:
        return '🟢 arquivado'
    return '❔ status indef.'


def mp_severity(case):
    txt = low(case.get('texto',''))
    if any(k in txt for k in HIGH_MP_KWS):
        return 'alta'
    if any(k in txt for k in ['transporte escolar','saúde','saude','hospital','escola','educação','educacao']) and any(k in txt for k in ['dano','falha','irregular','preju']):
        return 'alta'
    return 'media'


def mp_title(case, status):
    subj = extract_subject_mp(case.get('texto','')) or 'apuração em São Bento do Sul'
    subj = subj[0].lower() + subj[1:] if subj else subj
    prefix = {
        '🟠 TAC firmado': 'MP firma TAC sobre ',
        '🟠 ACNP firmado': 'MP firma acordo sobre ',
        '🔴 ACP ajuizada': 'MP leva à Justiça apuração sobre ',
        '⚫ prescrito': 'MP encerra caso prescrito sobre ',
        '🔴 apontou irregularidade': 'MP aponta irregularidade em ',
        '❔ status indef.': 'MP registra apuração sobre ',
        '🟢 arquivado': 'MP arquiva apuração sobre ',
    }.get(status, 'MP arquiva apuração sobre ')
    title = prefix + subj
    return title[:87].rstrip() + '...' if len(title) > 90 else title


def mp_description(case, status):
    txt = low(case.get('texto',''))
    subj = extract_subject_mp(case.get('texto','')) or 'o caso'
    subj = subj[0].lower() + subj[1:] if subj else subj
    if 'desvio de função configurado' in txt:
        result = 'O desvio de função foi reconhecido, mas sem dano ao erário ou improbidade.'
    elif 'ato de improbidade administrativa não configurado' in txt or 'inexistência de ato de improbidade administrativa' in txt:
        result = 'O MP concluiu que não houve ato de improbidade.'
    elif 'ausência de irregularidades' in txt or 'não há notícias de irregularidade' in txt or 'nao ha noticias de irregularidade' in deacc(txt):
        result = 'Não foram constatadas irregularidades.'
    elif 'irregularidade sanada' in txt or 'regularizado' in txt or 'correção' in txt:
        result = 'A irregularidade foi sanada durante a apuração.'
    elif 'dano ao erário' in txt or 'dano ao erario' in deacc(txt):
        result = 'O caso tratava de possível dano ao erário.'
    elif 'ajuizamento de ação civil pública' in txt or 'ajuizamento de acao civil publica' in deacc(txt):
        result = 'O procedimento terminou com ajuizamento de ação civil pública.'
    elif 'termo de ajustamento de conduta' in txt or 'tac' in txt:
        result = 'Foi firmado TAC para ajustar a conduta apurada.'
    elif 'acordo de não persecução cível' in txt or 'acordo de nao perseguicao civel' in deacc(txt) or 'acnp' in txt:
        result = 'Foi firmado acordo para encerrar a apuração.'
    elif 'prescrição' in txt or 'prescricao' in deacc(txt):
        result = 'O possível ilícito foi alcançado pela prescrição.'
    elif 'violação' in txt or 'violacao' in deacc(txt):
        result = 'O órgão apontou violação e adotou a providência indicada no texto.'
    else:
        result = 'O caso foi encerrado conforme o texto de origem.'
    closure = {
        '🟠 TAC firmado': 'encerrado com TAC', '🟠 ACNP firmado': 'encerrado com acordo',
        '🔴 ACP ajuizada': 'encerrado com ação judicial', '⚫ prescrito': 'encerrado por prescrição',
        '🔴 apontou irregularidade': 'encerrado com apontamento de irregularidade',
        '❔ status indef.': 'sem desfecho claro no texto', '🟢 arquivado': 'arquivado',
    }.get(status, 'arquivado')
    return norm(f'O MP apurou {subj}. {result} O caso ficou {closure}.')


def tce_selected_keep(case):
    header = low(case.get('header',''))
    ref = case.get('ref','')
    dec = low(case.get('decisao',''))
    if 'consulta' in header or ref.startswith('CON '):
        return False
    legal_reg = re.search(r'ordenar o registro', dec) and ('considerado legal' in dec or 'considerando-os legais' in dec or 'considerado legal conforme análise realizada' in dec)
    if legal_reg and ('aposent' in header or 'aposent' in dec or 'pensão' in header or 'pensao' in dec):
        return False
    substantive = any(k in dec for k in ['denegar o registro', 'considerado ilegal', 'multa', 'cautelar', 'sustação', 'sustacao', 'julgado irregular', 'apontou irregularidade', 'rejeição', 'rejeicao', 'ausência de certidão', 'ausencia de certidao'])
    procedural_only = any(k in dec for k in ['suspendendo-se', 'devolução dos autos', 'retorno dos autos', 'conhecer do recurso', 'não conhecer', 'nao conhecer']) and not substantive
    if procedural_only:
        return False
    if substantive:
        return True
    if 'fixar o prazo' in dec or 'sanar a restrição' in dec or 'sanar a restricao' in dec:
        return True
    if re.search(r'ordenar o registro', dec) and ('legal' in dec or 'considerado legal' in dec) and not substantive:
        return False
    if len(dec) < 100 and not substantive:
        return False
    return False


def tce_status(case):
    dec = low(case.get('decisao',''))
    if any(k in dec for k in ['multa aplicada', 'cominação', 'cominacao']) or ('multa' in dec and any(k in dec for k in ['julgado irregular', 'denegar'])):
        return '🔴 multa aplicada' if 'multa aplicada' in dec else '⬛ julgado irregular + multa'
    if 'denegar o registro' in dec or 'considerado ilegal' in dec or 'julgado irregular' in dec:
        return '⬛ julgado irregular'
    if 'apontou irregularidade' in dec:
        return '🔴 apontou irregularidade'
    if 'rejeição' in dec or 'rejeicao' in deacc(dec):
        return '🔴 parecer pela rejeição'
    if any(k in dec for k in ['cautelar', 'sustação', 'sustacao']):
        return '🟠 cautelar / sustação'
    if any(k in dec for k in ['fixar o prazo', 'sanar a restrição', 'sanar a restricao', 'ausência de certidão', 'ausencia de certidao']):
        return '🟡 em instrução (citação/audiência)'
    if 'não conhecer' in dec or 'nao conhecer' in deacc(dec):
        return '❔ não conhecido (sem análise)'
    return '❔ em tramitação'


def tce_severity(case, keep):
    if not keep:
        return 'media'
    dec = low(case.get('decisao',''))
    return 'alta' if any(k in dec for k in HIGH_TCE_KWS) or 'multa aplicada' in dec else 'media'


def tce_title(case, status):
    subj = extract_subject_tce(case)
    dec = low(case.get('decisao',''))
    if status == '⬛ julgado irregular':
        if 'ausência de certidão' in dec or 'ausencia de certidao' in deacc(dec) or 'sanar a restrição' in dec:
            return f'TCE cobra certidão de aposentadoria de {subj}' if subj else 'TCE cobra certidão em aposentadoria'
        return f'TCE barra aposentadoria de {subj}' if subj else 'TCE barra ato de aposentadoria'
    if status == '🟡 em instrução (citação/audiência)':
        if 'ausência de certidão' in dec or 'ausencia de certidao' in deacc(dec):
            return f'TCE cobra certidão ausente em aposentadoria de {subj}' if subj else 'TCE cobra certidão ausente em aposentadoria'
        return f'TCE abre prazo para ajustar ato de {subj}' if subj else 'TCE abre prazo para ajustar ato'
    if status == '🔴 apontou irregularidade':
        return f'TCE aponta irregularidade em {subj}' if subj else 'TCE aponta irregularidade'
    if status == '🟠 cautelar / sustação':
        return f'TCE suspende caso de {subj}' if subj else 'TCE suspende caso'
    if status == '❔ não conhecido (sem análise)':
        return f'TCE não conhece recurso sobre {subj}' if subj else 'TCE não conhece o caso'
    return f'TCE analisa {subj}' if subj else 'TCE analisa caso'


def tce_description(case, status):
    dec = low(case.get('decisao',''))
    subj = extract_subject_tce(case) or 'o ato'
    if status == '⬛ julgado irregular':
        if 'ausência de certidão' in dec or 'ausencia de certidao' in deacc(dec):
            return f'O Tribunal apontou falta de certidão de tempo de contribuição no ato de {subj}. O instituto recebeu prazo para regularizar a situação. O caso segue com irregularidade formal.'
        return f'O Tribunal negou o registro do ato de {subj} por irregularidade no benefício. A unidade gestora foi chamada a corrigir a falha. O caso ficou marcado como irregular.'
    if status == '🟡 em instrução (citação/audiência)':
        return f'O Tribunal deu prazo para sanar a pendência no ato de {subj}. Ainda não houve desfecho final de mérito. O caso segue em instrução.'
    if status == '🔴 apontou irregularidade':
        return f'O Tribunal identificou irregularidade no ato de {subj}. A decisão registrou a falha e determinou as providências cabíveis. O caso segue com apontamento formal.'
    if status == '🟠 cautelar / sustação':
        return f'O Tribunal suspendeu os efeitos do caso de {subj}. A medida é cautelar e antecede o julgamento definitivo. O processo segue em análise.'
    if status == '❔ não conhecido (sem análise)':
        return f'O Tribunal não conheceu do recurso ligado a {subj} porque faltou requisito de admissibilidade. Não houve análise do mérito. O caso foi encerrado sem exame substantivo.'
    return f'O Tribunal analisou o caso de {subj}. O texto de origem não deixa claro um desfecho de mérito mais forte. O caso segue na categoria indicada.'

for fname in files:
    data = json.load(open(IN_DIR / fname, 'r', encoding='utf-8'))
    cases = data['casos']
    selected_mp = selected_by_ref(cases, mp_phase_score)
    selected_tce = selected_by_ref(cases, tce_phase_score)
    out = []
    for idx, case in enumerate(cases):
        ref = case.get('ref', f'__idx_{idx}')
        if case.get('tipo') == 'mp':
            is_selected = selected_mp.get(ref, idx) == idx
            keep = mp_keep(case, is_selected)
            if keep:
                status = mp_status(case)
                severity = mp_severity(case)
                title = mp_title(case, status)
                description = mp_description(case, status)
            else:
                status = title = description = ''
                severity = 'media'
        else:
            is_selected = selected_tce.get(ref, idx) == idx
            keep = tce_selected_keep(case) and is_selected
            if keep:
                status = tce_status(case)
                severity = tce_severity(case, keep)
                title = tce_title(case, status)
                description = tce_description(case, status)
            else:
                status = title = description = ''
                severity = 'media'
        out.append({'i': case['i'], 'tipo': case['tipo'], 'keep': keep, 'title': title, 'description': description, 'status': status, 'severity': severity})
    json.dump(out, open(OUT_DIR / fname, 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
    with open(OUT_DIR / fname, 'a', encoding='utf-8') as f:
        f.write('\n')
print('rewritten')
