        return '🟠 parecer pela rejeição'
    if 'parecer pela aprovação' in t or 'parecer pela aprovacao' in t:
        return '🟢 parecer pela aprovação'
    if 'multa aplicada' in t:
        return '🔴 multa aplicada'
    if 'arquiv' in t or 'indeferimento' in t or 'sem necessidade' in t or 'inexistência de fundamento' in t or 'inexistencia de fundamento' in t or 'perda do objeto' in t:
        return '🟢 arquivado'
    return '❔ status indef.'


def title(text, status):
    t = re.sub(r'\s+', ' ', text or '').strip()
    low = t.lower()
    if 'ação civil pública' in low or 'acao civil publica' in low:
        target = t.split('.', 1)[0]
        return f'MP ajuíza ação civil pública contra {target}'
    if 'termo de ajustamento de conduta' in low or 'ajuste de condutas' in low:
        target = t.split('.', 1)[0]
        return f'MP firma TAC com {target}'
    if 'acordo de não persecução penal' in low or 'anpp' in low or 'acnp' in low:
        target = t.split('.', 1)[0]
        return f'MP encerra caso com acordo penal para {target}'
    if any(k in low for k in animal_terms):
        return 'MP arquiva caso sobre animais em Joinville' if 'arquiv' in low or 'indefer' in low else 'MP apura caso de bem-estar animal em Joinville'
    if any(k in low for k in health_terms):
        return 'MP arquiva caso de saúde em Joinville' if 'arquiv' in low or 'indefer' in low or 'perda do objeto' in low else 'MP apura atendimento de saúde em Joinville'
    if any(k in low for k in commercial_terms):
        return 'MP arquiva apuração sobre empresa ou comércio em Joinville' if 'arquiv' in low or 'indefer' in low else 'MP apura caso sobre empresa ou comércio em Joinville'
    return 'MP apura caso em Joinville' if status.startswith('🟡') or status == '❔ status indef.' else 'MP arquiva caso em Joinville'


def desc(text, status):
    t = re.sub(r'\s+', ' ', text or '').strip()
    low = t.lower()
    if 'ação civil pública' in low or 'acao civil publica' in low:
        return 'O texto informa que o Ministério Público ajuizou ação civil pública. O trecho não detalha os fatos que motivaram a medida.'
    if 'termo de ajustamento de conduta' in low or 'ajuste de condutas' in low:
        return 'O caso foi encerrado com a celebração de termo de ajustamento de conduta. O cumprimento seguirá em procedimento administrativo.'
    if 'acordo de não persecução penal' in low or 'anpp' in low or 'acnp' in low:
        return 'O texto indica que a reparação foi tratada em acordo penal. A notícia de fato foi indeferida após essa solução.'
    if any(k in low for k in animal_terms):
        return 'A apuração tratou de situação de vulnerabilidade ou maus-tratos envolvendo animal(is). O órgão de proteção animal atuou e o caso foi encerrado.'
    if any(k in low for k in health_terms):
        return 'A Secretaria de Saúde ou o hospital adotou as providências necessárias. Com a demanda atendida, o inquérito foi arquivado.'
    return 'O caso foi avaliado pelo Ministério Público conforme o texto de origem.'

for f in inputs:
    data = json.loads(f.read_text())
    out = []
    for c in data['casos']:
        order = c['i']  # not unique across files? yes unique enough here
        keep = substantive(c.get('texto','')) and best[c['ref']] == next(x['order'] for x in all_cases if x['ref']==c['ref'] and x['i']==c['i']) and not re.search(r'instauraç|instauracao|procedimento administrativo', c.get('header','').lower())
        if not keep:
            out.append({'i': c['i'], 'tipo': c['tipo'], 'keep': False, 'title': '', 'description': '', 'status': '', 'severity': ''})
            continue
        st = classify_status(c.get('texto',''), c.get('header',''))
        out.append({'i': c['i'], 'tipo': c['tipo'], 'keep': True, 'title': title(c.get('texto',''), st), 'description': desc(c.get('texto',''), st), 'status': st, 'severity': 'alta' if False else 'media'})
    (outdir / f.name).write_text(json.dumps(out, ensure_ascii=False, indent=2) + '\n')
    print(f'updated {f.name}: keep={sum(1 for x in out if x["keep"])}')
