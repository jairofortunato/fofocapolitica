import json, re, os
from pathlib import Path
root = Path('/Users/jairofortunato/mp')
inputs = [root/'pdf_template/amunesc/_lotes/joinville__43.json', root/'pdf_template/amunesc/_lotes/joinville__44.json', root/'pdf_template/amunesc/_lotes/joinville__45.json']
outdir = root/'pdf_template/amunesc/_lotes_curados'
outdir.mkdir(parents=True, exist_ok=True)

def phase_rank(header: str):
    h = header.lower()
    base = 0
    if 'inquérito civil público' in h or 'inquerito civil público' in h or 'inquérito civil' in h or 'inquerito civil' in h:
        base = 40
    elif 'procedimento preparatório' in h or 'procedimento preparatorio' in h:
        base = 30
    elif 'notícia de fato' in h or 'noticia de fato' in h:
        base = 20
    elif 'procedimento administrativo' in h:
        base = 10
    action = 1 if 'conclus' in h or 'conclusão' in h or 'conclusao' in h else 0
    return base + action

def substantive(text: str):
    t = re.sub(r'\s+', ' ', text or '').strip()
    if not t:
        return False
    low = t.lower()
    if low in {'a apurar.', 'a apurar', 'sigiloso.', 'sigilosa.', 'sigiloso', 'sigilosa', 'ofício.', 'oficio.', 'de ofício.', 'de oficio.', 'pessoa a identificar.', 'pessoa a identificar', 'a apurar e sigilo.', 'sigilo.', 'ofício'}:
        return False
    if len(t) < 20:
        return False
    if re.fullmatch(r'[A-Za-zÀ-ÿ0-9 .,&\-\(\)\/]+', t) and len(re.findall(r'[A-Za-zÀ-ÿ]{4,}', t)) <= 3 and ':' not in t:
        # likely just names / bare entity / no factual substance
        if 'conclus' not in low and 'arquiv' not in low and 'ajuste' not in low and 'tac' not in low and 'ação civil pública' not in low and 'acao civil publica' not in low:
            return False
    return True

def best_ref_cases(all_cases):
    by_ref = {}
    for item in all_cases:
        by_ref.setdefault(item['ref'], []).append(item)
    best = {}
    for ref, items in by_ref.items():
        items_sorted = sorted(items, key=lambda x: (phase_rank(x['header']), x['order']))
        best[ref] = items_sorted[-1]['order']
    return best

all_cases = []
for f in inputs:
    data = json.loads(f.read_text())
    for idx, c in enumerate(data['casos']):
        c = dict(c)
        c['order'] = len(all_cases)
        all_cases.append(c)

best_order_by_ref = best_ref_cases(all_cases)

animal_terms = ['canino', 'canina', 'caninos', 'caninas', 'cão', 'cao', 'cães', 'caes', 'felino', 'gato', 'gatos', 'bode', 'bezerro', 'coruja', 'aves', 'peixes', 'tartaruga', 'tartarugas', 'porquinho da índia', 'porquinho-da-índia']
health_terms = ['saúde', 'saude', 'maternidade', 'hospital', 'consulta', 'consultas', 'medicamento', 'medicamentos', 'fila', 'ortopedia', 'neurologista', 'urologista', 'hemodinâmica', 'hemodinamica']
commercial_terms = ['bar ', 'restaurante', 'conveniência', 'conveniencia', 'ótica', 'otica', 'supermercado', 'empresa', 'ltda', 's/a', 's.a.', 'clínica', 'clinica']

# explicit status overrides by keywords

def classify_status(text, header):
    t = (text or '').lower()
    h = (header or '').lower()
    if 'ação civil pública' in t or 'acao civil publica' in t or 'propositura de ação civil pública' in t or 'propositura de acao civil publica' in t:
        return '🔴 ACP ajuizada'
    if 'acordo de não persecução penal' in t or 'acordo de nao persecução penal' in t or 'acordo de nao persecução penal' in t or 'acordo de nao persecução penal' in t or 'acordo de não persecução penal' in t or 'acordo de não persecução penal' in t or 'acordo de não persecução penal firm' in t or 'acordo de não persecução penal firmado' in t or 'anpp' in t or 'acnp' in t:
        return '🟠 ACNP firmado'
    if 'termo de ajustamento de conduta' in t or 'termo de ajuste de condutas' in t or 'ajuste de condutas' in t or 'tac' in t:
        return '🟠 TAC firmado'
    if 'prescrito' in t:
        return '⚫ prescrito'
    if 'não conhecido' in t or 'nao conhecido' in t:
        return '❔ não conhecido (sem análise)'
    if 'cautelar' in t or 'sustação' in t or 'sustacao' in t:
        return '🟠 cautelar / sustação'
    if 'julgado regular' in t:
        return '🟢 julgado regular'
    if 'julgado irregular' in t and 'multa' in t:
        return '⬛ julgado irregular + multa'
    if 'julgado irregular' in t:
        return '⬛ julgado irregular'
    if 'parecer pela rejeição' in t or 'parecer pela rejeicao' in t:
        return '🟠 parecer pela rejeição'
    if 'parecer pela aprovação' in t or 'parecer pela aprovacao' in t:
        return '🟢 parecer pela aprovação'
    if 'multa aplicada' in t:
        return '🔴 multa aplicada'
    if 'arquiv' in t or 'indeferimento' in t or 'sem necessidade' in t or 'não há fundamento' in t or 'nao ha fundamento' in t or 'inexistência de fundamento' in t or 'inexistencia de fundamento' in t or 'perda do objeto' in t:
        return '🟢 arquivado'
    if 'instauração' in h or 'instauracao' in h:
        return '🟡 em apuração'
    return '❔ status indef.'


def summarize_title(text, status):
    t = re.sub(r'\s+', ' ', text or '').strip()
    low = t.lower()
    if 'ação civil pública' in low or 'acao civil publica' in low:
        m = re.match(r'([^\.]+)\.', t)
        target = m.group(1) if m else 'caso'
        return f'MP ajuíza ação civil pública contra {target}'
    if 'termo de ajustamento de conduta' in low or 'ajuste de condutas' in low or 'tac' in low:
        m = re.match(r'([^\.]+)\.', t)
        target = m.group(1) if m else 'investigado'
        return f'MP firma TAC com {target}'
    if 'acordo de não persecução penal' in low or 'acnp' in low or 'anpp' in low:
        m = re.match(r'([^\.]+)\.', t)
        target = m.group(1) if m else 'investigado'
        return f'MP encerra caso com acordo penal para {target}'
    if any(k in low for k in animal_terms):
        if 'arquiv' in low or 'indefer' in low or 'perda do objeto' in low:
            return 'MP arquiva caso sobre animais em Joinville'
        if 'resgate' in low:
            return 'MP apura resgate de animal em Joinville'
        return 'MP apura caso de bem-estar animal em Joinville'
    if any(k in low for k in health_terms):
        if 'arquiv' in low or 'indefer' in low:
            return 'MP arquiva caso de saúde em Joinville'
        return 'MP apura atendimento de saúde em Joinville'
    if any(k in low for k in commercial_terms):
        if 'arquiv' in low or 'indefer' in low:
            return 'MP arquiva apuração sobre empresa ou comércio em Joinville'
        return 'MP apura caso sobre empresa ou comércio em Joinville'
    if 'prescrição' in low or 'prescrito' in low:
        return 'MP reconhece prescrição do caso'
    return 'MP apura caso em Joinville'


def make_description(text, status):
    t = re.sub(r'\s+', ' ', text or '').strip()
    low = t.lower()
    if 'ação civil pública' in low or 'acao civil publica' in low:
        return 'O texto informa que o Ministério Público ajuizou ação civil pública. O trecho não detalha os fatos que motivaram a medida.'
    if 'termo de ajustamento de conduta' in low or 'ajuste de condutas' in low or 'tac' in low:
        return 'O caso foi encerrado com a celebração de termo de ajustamento de conduta. O cumprimento seguirá em procedimento administrativo.'
    if 'acordo de não persecução penal' in low or 'anpp' in low or 'acnp' in low:
        return 'O texto indica que a reparação do dano foi tratada em acordo penal. A notícia de fato foi indeferida após essa solução.'
    if any(k in low for k in animal_terms):
        if 'arquiv' in low or 'indefer' in low or 'perda do objeto' in low:
            return 'A apuração tratou de situação de vulnerabilidade ou maus-tratos envolvendo animal(is). O órgão de proteção animal atuou e o caso foi arquivado ou indeferido.'
        if 'encaminhamento à autoridade policial' in low or 'autoridade policial' in low:
            return 'A situação animal foi apurada e, além das medidas de proteção, houve encaminhamento à polícia. O caso segue na via própria quando indicado no texto.'
        return 'O caso envolve atuação do órgão de proteção animal e providências para resguardar o bem-estar dos animais.'
    if any(k in low for k in health_terms):
        if 'arquiv' in low or 'indefer' in low or 'perda do objeto' in low:
            return 'A Secretaria de Saúde ou o hospital adotou as providências necessárias. Com a demanda atendida, o inquérito foi arquivado.'
        return 'O texto trata de demanda de saúde e atuação do poder público para atender a necessidade apontada.'
    if 'notícia de fato' in low or 'noticia de fato' in low:
        if 'arquiv' in low or 'indefer' in low:
            return 'A notícia de fato foi encerrada após diligências e sem necessidade de novas medidas. O caso foi arquivado ou indeferido.'
        return 'A notícia de fato foi instaurada para apurar o tema indicado no texto.'
    return 'O caso foi avaliado pelo Ministério Público conforme o texto de origem.'

for f in inputs:
    data = json.loads(f.read_text())
    casos = data['casos']
    out = []
    for c in casos:
        keep = substantive(c.get('texto','')) and best_order_by_ref.get(c['ref']) == next(x['order'] for x in all_cases if x['ref']==c['ref'] and x['i']==c['i'])
        if not keep:
            out.append({'i': c['i'], 'tipo': c['tipo'], 'keep': False, 'title': '', 'description': '', 'status': '', 'severity': ''})
            continue
        status = classify_status(c.get('texto',''), c.get('header',''))
        severity = 'alta' if any(k in c.get('texto','').lower() for k in ['multa aplicada', 'dano ao erário', 'desvio ao erário', 'improbidade', 'fraude em licitação', 'nepotismo confirmado']) else 'media'
        out.append({'i': c['i'], 'tipo': c['tipo'], 'keep': True, 'title': summarize_title(c.get('texto',''), status), 'description': make_description(c.get('texto',''), status), 'status': status, 'severity': severity})
    outf = outdir / f.name
    outf.write_text(json.dumps(out, ensure_ascii=False, indent=2) + '\n')
    print(f'Wrote {outf}')
